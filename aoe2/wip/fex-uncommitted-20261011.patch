+  fextl::shared_ptr<CodeBuffer> GetLatest();
+
+  // Replaces Full with a new pool buffer, unless another thread already did.
+  fextl::shared_ptr<CodeBuffer> StartNew(const CodeBuffer* Full);
+
+private:
+  SharedCodeBufferManager& Registry;
+  size_t Size {};
+  std::mutex Lock;
+  fextl::shared_ptr<CodeBuffer> Latest;
+};
