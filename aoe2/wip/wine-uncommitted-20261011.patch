     return i < format_count;
 }
 
+/* How to present an image whose size differs from the window's: keeping its aspect ratio, centred, where the host
+ * supports it (as a display's scaler would show an emulated display mode), else stretched. */
+static VkPresentScalingFlagsEXT get_present_scaling( struct vulkan_physical_device *physical_device, VkSurfaceKHR host_surface,
+                                                     VkPresentModeKHR present_mode, VkPresentGravityFlagsEXT *gravity )
+{
+    struct vulkan_instance *instance = physical_device->instance;
+    VkSurfacePresentModeEXT mode = {.sType = VK_STRUCTURE_TYPE_SURFACE_PRESENT_MODE_EXT, .presentMode = present_mode};
+    VkPhysicalDeviceSurfaceInfo2KHR info = {.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SURFACE_INFO_2_KHR, .pNext = &mode,
+                                            .surface = host_surface};
+    VkSurfacePresentScalingCapabilitiesEXT scaling = {.sType = VK_STRUCTURE_TYPE_SURFACE_PRESENT_SCALING_CAPABILITIES_EXT};
+    VkSurfaceCapabilities2KHR capabilities = {.sType = VK_STRUCTURE_TYPE_SURFACE_CAPABILITIES_2_KHR, .pNext = &scaling};
+
+    *gravity = 0;
+    if (!instance->p_vkGetPhysicalDeviceSurfaceCapabilities2KHR ||
+        instance->p_vkGetPhysicalDeviceSurfaceCapabilities2KHR( physical_device->host.physical_device, &info, &capabilities ))
+        return VK_PRESENT_SCALING_STRETCH_BIT_EXT;
+    if ((scaling.supportedPresentScaling & VK_PRESENT_SCALING_ASPECT_RATIO_STRETCH_BIT_EXT) &&
+        (scaling.supportedPresentGravityX & VK_PRESENT_GRAVITY_CENTERED_BIT_EXT) &&
+        (scaling.supportedPresentGravityY & VK_PRESENT_GRAVITY_CENTERED_BIT_EXT))
+    {
+        *gravity = VK_PRESENT_GRAVITY_CENTERED_BIT_EXT;
+        return VK_PRESENT_SCALING_ASPECT_RATIO_STRETCH_BIT_EXT;
+    }
+    return VK_PRESENT_SCALING_STRETCH_BIT_EXT;
+}
